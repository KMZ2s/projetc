        { "id": "feature_3_desc",  "type": "text", "label": "Benefício 3 — Descrição", "default": "1ª troca grátis e sem burocracia" },
        { "id": "feature_4_title", "type": "text", "label": "Benefício 4 — Título",    "default": "Parcelamento" },
        { "id": "feature_4_desc",  "type": "text", "label": "Benefício 4 — Descrição", "default": "Em até 12x ou PIX com 5% OFF" }
